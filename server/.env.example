# Auth
GATEWAY_API_KEYS=sk-demo:demo-user
GATEWAY_ALLOW_ANONYMOUS=true          # set false in production

# Limits
GATEWAY_RPM_LIMIT=30
GATEWAY_TPM_LIMIT=60000
GATEWAY_HEARTBEAT_S=15

# Upstreams (only the ones your catalog references need to be set)
GATEWAY_OPENAI_BASE_URL=http://localhost:8000/v1
GATEWAY_OPENAI_API_KEY=
GATEWAY_ANTHROPIC_API_KEY=

# Catalog override
# GATEWAY_MODELS_FILE=./models.json

GATEWAY_CORS_ORIGINS=http://localhost:5173
